{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地阅读器",
  "version": "1.0.0",
  "identifier": "com.localread.app",
  "build": {
    "beforeDevCommand": "npm run tauri:serve",
    "devUrl": "http://127.0.0.1:1450",
    "beforeBuildCommand": "npm run build:tauri-assets",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "本地阅读",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../build/icon.ico"]
  }
}
